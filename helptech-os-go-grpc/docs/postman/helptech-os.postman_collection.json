    { "name": "Login", "event": [{"listen":"test","script":{"exec":["const json = pm.response.json();","if (json.token) pm.collectionVariables.set('token', json.token);"],"type":"text/javascript"}}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"allan@helptech.com\",\n  \"password\": \"123456\"\n}" } } },
