{
  "info": {
    "name": "HelpTech OS - Fluxo completo com testes",
    "description": "Collection pronta para importar e testar o projeto HelpTech OS pelo API Gateway. Execute primeiro Health checks, depois Fluxo completo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "auth_direct_url",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "cliente_direct_url",
      "value": "http://localhost:8002",
      "type": "string"
    },
    {
      "key": "ordem_direct_url",
      "value": "http://localhost:8003",
      "type": "string"
    },
    {
      "key": "financeiro_direct_url",
