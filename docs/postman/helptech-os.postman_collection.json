    },
    {
      "key": "cliente_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "ordem_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pagamento_id",
      "value": "1",
      "type": "string"
    }
