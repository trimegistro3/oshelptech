  "item": [
    {
      "name": "00 - Health checks",
      "item": [
        {
          "name": "Gateway /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(json.status).to.eql('ok'));",
                  "pm.test('service api-gateway', () => pm.expect(json.service).to.eql('api-gateway'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Auth direto /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(json.status).to.eql('ok'));",
                  "pm.test('service auth-service', () => pm.expect(json.service).to.eql('auth-service'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{auth_direct_url}}/health"
          }
        },
        {
          "name": "Cliente direto /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(json.status).to.eql('ok'));",
                  "pm.test('service cliente-service', () => pm.expect(json.service).to.eql('cliente-service'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{cliente_direct_url}}/health"
          }
        },
        {
          "name": "Ordem direto /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(json.status).to.eql('ok'));",
                  "pm.test('service ordem-service', () => pm.expect(json.service).to.eql('ordem-service'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ordem_direct_url}}/health"
          }
        },
        {
          "name": "Financeiro direto /health",
          "event": [
            {
              "listen": "test",
